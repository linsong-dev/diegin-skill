{
    "id":  "rule_session_image_protection",
    "name":  "会话图片保护规则",
    "description":  "每次工具调用后自动检查并修复会话文件中因上传图片导致的 input_image 格式不兼容问题（Keysync/Bifrost 不支持 Responses API 图片格式）",
    "severity":  "critical",
    "scope":  "post_tool_use",
    "trigger_condition":  "tool_name == \u0027view_image\u0027",
    "action":  "run_session_image_cleanup",
    "tags":  [
                 "session",
                 "image",
                 "keysync",
                 "bifrost",
                 "protection"
             ],
    "auto_fix":  true,
    "logic":  {
                  "detect":  "会话文件中存在 type=input_image 的内容块",
                  "fix":  "替换为 [用户上传了一张图片] 文本占位",
                  "backup":  "原文件自动备份到 archived_sessions/"
              },
    "execution":  {
                      "type":  "powershell_script",
                      "script":  "diegin_session_image_clean.ps1",
                      "timeout":  15,
                      "run_on":  "post_tool_use"
                  },
    "created_at":  "2026-07-09",
    "source":  "手动创建 - 解决 Keysync Bifrost Responses API 图片兼容性问题",
    "lifecycle_status":  "archived",
    "confidence":  5.0,
    "deprecated":  true,
    "superseded_by":  "interception_rules.json#rule_session_image_protection",
